#!/usr/bin/env python3
"""Quote source for the Daily Quote plugin.

  dailyquote get <minutes> [lang]   print the current quote; fetch a new one
                                    first if it is older than <minutes>
  dailyquote next [lang]            pick a new quote now and print it

A quote is {"text", "lang", "author", "tr": {lang: translation}, "source",
"shown_at"}: the original in its own language (any) and translations. [lang]
(en or ru, default ru) is the language to translate into; the output adds
"bottom", that translation, empty when the original is already in it.

A new quote is either from the bundled multilingual set (quotes.json: English,
Japanese, Latin, French, German, Chinese… with hand-made en/ru translations)
or from a site — ZenQuotes (quote of the day once a day, and random) or
DummyJSON (random, religious authors skipped), both English — machine-
translated (MyMemory, then Google). Translations are cached; fetched quotes
join a local pool used offline. Recent quotes are not repeated.
"""

import html
import json
import os
import random
import sys
import time
import urllib.parse
import urllib.request
from datetime import date
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
BUNDLED = HERE / "quotes.json"
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "omarchy/dailyquote"
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "dailyquote"
CURRENT = STATE / "current.json"
POOL = CACHE / "pool.json"
POOL_MAX = 2000
RECENT_MAX = 40
TIMEOUT = 6
UA = "omarchy-dailyquote/1.0"

# DummyJSON mixes in a lot of religious sayings; this plugin is about
# general quotes, so those authors are skipped.
SKIP_AUTHORS = ("(r.a)", "abu bakr", "umar ibn", "ali ibn", "prophet", "uthman", "imam ")


def http_json(url: str):
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
        return json.loads(r.read().decode("utf-8", "replace"))


def load(path: Path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def save(path: Path, data) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False))
    tmp.replace(path)


def normalize(q: dict) -> dict:
    """Old entries were {"en", "ru"}; now {"text", "lang", "tr"}."""
    if not isinstance(q, dict):
        return {}
    if "text" not in q and q.get("en"):
        q = {"text": q["en"], "lang": "en", "author": q.get("author", ""), "source": q.get("source", ""),
             "tr": {"ru": q["ru"]} if q.get("ru") else {}, **({"shown_at": q["shown_at"]} if "shown_at" in q else {})}
    q.setdefault("lang", "en")
    q.setdefault("tr", {})
    return q


def key(q: dict) -> str:
    return "".join(ch for ch in str(q.get("text") or q.get("en") or "").lower() if ch.isalnum())[:80]


def sentence_case(text: str) -> str:
    """DummyJSON Title-Cases Every Word; turn that back into a sentence."""
    words = text.split()
    if len(words) > 2 and sum(w[:1].isupper() for w in words) >= len(words) * 0.8:
        text = text.lower()
        text = text[:1].upper() + text[1:]
        for w in ("i", "i'm", "i've", "i'll", "i'd", "god"):
            text = " ".join(x[:1].upper() + x[1:] if x.strip(".,!?;:") == w else x for x in text.split(" "))
    return text


# ---- sources ---------------------------------------------------------------

def zen_today(state: dict):
    if state.get("zen_today") == date.today().isoformat():
        return None                                   # already shown today's
    d = http_json("https://zenquotes.io/api/today")[0]
    state["zen_today"] = date.today().isoformat()
    return {"en": html.unescape(d["q"]).strip(), "author": d["a"].strip(), "source": "ZenQuotes"}


def zen_random(_state: dict):
    d = http_json("https://zenquotes.io/api/random")[0]
    if "too many requests" in d.get("q", "").lower():
        return None
    return {"en": html.unescape(d["q"]).strip(), "author": d["a"].strip(), "source": "ZenQuotes"}


def dummy_random(_state: dict):
    for _ in range(4):
        d = http_json("https://dummyjson.com/quotes/random")
        author = str(d.get("author", "")).strip()
        if any(s in author.lower() for s in SKIP_AUTHORS) or len(d.get("quote", "")) > 220:
            continue
        return {"en": sentence_case(str(d["quote"]).strip()), "author": author, "source": "DummyJSON"}
    return None


SOURCES = [zen_today, zen_random, dummy_random]


# ---- translation -------------------------------------------------------------

def translate(text: str, src: str = "en", dst: str = "ru") -> str:
    try:
        q = urllib.parse.urlencode({"q": text, "langpair": f"{src}|{dst}"})
        d = http_json("https://api.mymemory.translated.net/get?" + q)
        out = html.unescape(str(d.get("responseData", {}).get("translatedText", ""))).strip()
        if d.get("responseStatus") == 200 and out and "MYMEMORY" not in out.upper() and out != text:
            return out
    except Exception:
        pass
    try:
        q = urllib.parse.urlencode({"client": "gtx", "sl": src, "tl": dst, "dt": "t", "q": text})
        d = http_json("https://translate.googleapis.com/translate_a/single?" + q)
        out = "".join(part[0] for part in d[0] if part and part[0]).strip()
        if out and out != text:
            return out
    except Exception:
        pass
    return ""


# ---- picking ---------------------------------------------------------------

def all_offline() -> list:
    return [normalize(q) for q in load(BUNDLED, []) + load(POOL, []) if (q.get("text") or q.get("en"))]


def fetch_online(state: dict, recent: set, lang: str):
    order = SOURCES[:1] + random.sample(SOURCES[1:], len(SOURCES) - 1)
    for src in order:
        try:
            q = src(state)
        except Exception:
            q = None
        if not q or not q["en"] or key({"text": q["en"]}) in recent:
            continue
        q = {"text": q["en"], "lang": "en", "author": q["author"], "source": q["source"], "tr": {}}
        if lang != "en":
            tr = translate(q["text"], "en", lang)
            if not tr:
                return None                            # no translation: use the offline set
            q["tr"][lang] = tr.replace(" - ", " — ")
        pool = load(POOL, [])
        if key(q) not in {key(normalize(p)) for p in pool}:
            pool.append(q)
            save(POOL, pool[-POOL_MAX:])
        return q
    return None


def pick_offline(recent: set):
    items = all_offline()
    fresh = [q for q in items if key(q) not in recent] or items
    if not fresh:
        return {"text": "Well done is better than well said.", "lang": "en", "author": "Benjamin Franklin",
                "tr": {"ru": "Хорошо сделанное лучше хорошо сказанного."}}
    q = dict(random.choice(fresh))
    q.setdefault("source", "offline")
    return q


def ensure_translation(q: dict, lang: str) -> dict:
    """Make sure q has a translation into lang (unless it is in lang already)."""
    if lang == q.get("lang") or q["tr"].get(lang):
        return q
    for other in all_offline():                         # known from the set or the pool?
        if key(other) == key(q) and other["tr"].get(lang):
            q["tr"][lang] = other["tr"][lang]
            return q
    tr = translate(q["text"], q.get("lang", "en"), lang)
    if tr:
        q["tr"][lang] = tr.replace(" - ", " — ")
    return q


def new_quote(state: dict, lang: str) -> dict:
    recent = set(state.get("recent", []))
    # mix: the multilingual set about half the time, otherwise a site
    q = None if random.random() < 0.45 else fetch_online(state, recent, lang)
    q = q or pick_offline(recent)
    q = ensure_translation(q, lang)
    q["shown_at"] = int(time.time())
    state["recent"] = (state.get("recent", []) + [key(q)])[-RECENT_MAX:]
    state["current"] = q
    save(CURRENT, state)
    return q


def output(q: dict, lang: str) -> dict:
    out = dict(q)
    out["bottom"] = "" if lang == q.get("lang") else q["tr"].get(lang, "")
    return out


def main() -> int:
    args = sys.argv[1:]
    state = load(CURRENT, {})
    if not isinstance(state, dict):
        state = {}
    cmd = args[0] if args else ""
    if cmd == "next":
        lang = args[1] if len(args) > 1 else "ru"
        q = new_quote(state, lang)
    elif cmd == "get":
        minutes = float(args[1]) if len(args) > 1 else 240
        lang = args[2] if len(args) > 2 else "ru"
        cur = normalize(state.get("current") or {})
        if cur.get("text") and time.time() - cur.get("shown_at", 0) < minutes * 60:
            had = dict(cur["tr"])
            q = ensure_translation(cur, lang)
            if q["tr"] != had:                          # new language: remember the translation
                state["current"] = q
                save(CURRENT, state)
        else:
            q = new_quote(state, lang)
    else:
        print(__doc__, file=sys.stderr)
        return 1
    print(json.dumps(output(q, lang), ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())

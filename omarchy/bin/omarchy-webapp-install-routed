#!/bin/bash

# omarchy:summary=Create a web app launcher, choosing whether it opens through the tunnel or directly
# omarchy:args=[]
#
# Interactive front for omarchy-webapp-install with one extra question: the
# route. "Through the tunnel" uses the default browser (Brave), like any
# Omarchy web app; "Direct" launches it in Chromium, which Happ's per-app
# bypass sends around the tunnel (see README, "Туннель и браузеры").
# Wired into the Omarchy menu as Install → Web App by install.sh.

set -uo pipefail

TUNNEL="Through the tunnel (default browser)"
DIRECT="Direct (Chromium)"

echo -e "\e[32mLet's create a new web app you can start with the app launcher.\n\e[0m"

ROUTE=$(gum choose --header "Route" "$TUNNEL" "$DIRECT") || exit 1
APP_NAME=$(gum input --prompt "Name> " --placeholder "My favorite web app") || exit 1
APP_URL=$(gum input --prompt "URL> " --placeholder "https://example.com") || exit 1

if [[ -z $APP_NAME || -z $APP_URL ]]; then
  echo "You must set app name and app URL!"
  exit 1
fi
# Same normalisation omarchy-webapp-install applies, needed here because the
# direct route builds its own Exec line from the URL.
[[ $APP_URL =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]] || APP_URL="https://$APP_URL"

CUSTOM_EXEC=""
[[ $ROUTE == "$DIRECT" ]] && CUSTOM_EXEC="uwsm-app -- chromium --app=$APP_URL"

# Empty icon: omarchy fetches the site's own icon. If that fails it exits
# without creating the launcher, so ask for an icon and try once more.
if ! omarchy-webapp-install "$APP_NAME" "$APP_URL" "" "$CUSTOM_EXEC"; then
  ICON_REF=$(gum input --prompt "Icon URL/name> " \
    --placeholder "Could not fetch favicon automatically. Enter PNG icon URL or icon name") || exit 1
  omarchy-webapp-install "$APP_NAME" "$APP_URL" "${ICON_REF:-applications-internet}" "$CUSTOM_EXEC" || exit 1
fi

echo -e "You can now find $APP_NAME using the app launcher (SUPER + SPACE)\n"

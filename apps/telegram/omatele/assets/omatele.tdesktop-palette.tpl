//== message history =======================================================
// Both incoming and outgoing bubbles use the same dark background, so the
// chat reads as one surface. Who sent it is cued by the bubble drop-shadow:
// blue under theirs, red under yours. Telegram has no real bubble-border
// key, so the shadow is the only edge tint available - subtle on desaturated
// themes, clear on colourful ones. Swap {{ red }}/{{ blue }} below for fixed
// hex if you want it stronger regardless of theme.
historyTextInFg: {{ foreground }};
historyTextInFgSelected: {{ bright_foreground }};
historyTextOutFg: {{ foreground }};
historyTextOutFgSelected: {{ bright_foreground }};
historyLinkInFg: {{ accent }};
historyLinkInFgSelected: {{ accent }};
historyLinkOutFg: {{ accent }};
historyLinkOutFgSelected: {{ accent }};

// Both bubbles the same colour, but a shade LIGHTER than the chat area so
// they read as raised cards - otherwise the right-aligned outgoing bubble
// blends into the background and looks like it is not there. (Alignment is
// not a palette thing: outgoing stays on the right unless you turn off
// Settings > Chat settings > Message bubbles.)
msgInBg: {{ mix background foreground 7% }};
msgInBgSelected: {{ mix background accent 28% }};
msgOutBg: {{ mix background foreground 7% }};
msgOutBgSelected: {{ mix background accent 28% }};

msgInShadow: {{ blue }};
msgInShadowSelected: {{ bright_blue }};
msgOutShadow: {{ red }};
msgOutShadowSelected: {{ bright_red }};

msgSelectOverlay: {{ mix background accent 25% }};
msgStickerOverlay: {{ mix background accent 30% }};

msgInServiceFg: {{ accent }};
msgInServiceFgSelected: {{ bright_foreground }};
msgOutServiceFg: {{ accent }};
msgOutServiceFgSelected: {{ bright_foreground }};

msgInDateFg: {{ dark_foreground }};
msgInDateFgSelected: {{ foreground }};
msgOutDateFg: {{ dark_foreground }};
msgOutDateFgSelected: {{ foreground }};

msgServiceBg: {{ mix background foreground 12% }};
msgServiceBgSelected: {{ mix background accent 30% }};
msgServiceFg: {{ foreground }};

msgInReplyBarColor: {{ accent }};
msgInReplyBarSelColor: {{ accent }};
msgOutReplyBarColor: {{ red }};
msgOutReplyBarSelColor: {{ bright_red }};

msgInMonoFg: {{ cyan }};
msgInMonoFgSelected: {{ cyan }};
msgOutMonoFg: {{ cyan }};
msgOutMonoFgSelected: {{ cyan }};

//== compose area ==========================================================
historyComposeAreaBg: {{ background }};
historyComposeAreaFg: {{ foreground }};
historyComposeAreaFgService: {{ accent }};
historyComposeIconFg: {{ dark_foreground }};
historyComposeIconFgOver: {{ foreground }};
historySendIconFg: {{ accent }};
historySendIconFgOver: {{ bright_foreground }};
historyComposeButtonBg: {{ dark_background }};
historyComposeButtonBgOver: {{ mix background foreground 8% }};
historyComposeButtonBgRipple: {{ mix background foreground 14% }};
historyPinnedBg: {{ background }};
historyScrollBarBg: {{ mix background foreground 20% }};
historyScrollBg: {{ mix background foreground 10% }};


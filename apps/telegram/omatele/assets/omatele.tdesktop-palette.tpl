// omatele - Telegram Desktop palette generated by Omarchy from the active
// theme's colors.toml. Do not edit: rewritten on every `omarchy theme set`.
// Keys not listed here fall back to Telegram's built-in {{ mode }} scheme.

//== base surfaces =============================================================
windowBg: {{ background }};
windowBgOver: {{ mix background foreground 8% }};
windowBgRipple: {{ mix background foreground 14% }};
windowFg: {{ foreground }};
windowFgOver: {{ bright_foreground }};
windowSubTextFg: {{ dark_foreground }};
windowSubTextFgOver: {{ mix background foreground 55% }};
windowBoldFg: {{ bright_foreground }};
windowBoldFgOver: {{ bright_foreground }};
windowActiveTextFg: {{ accent }};
windowShadowFg: {{ darker_background }};
windowShadowFgFallback: {{ background }};
shadowFg: {{ mix background foreground 12% }};
boxBg: {{ background }};

//== active (accent) buttons ==================================================
activeButtonBg: {{ accent }};
activeButtonBgOver: {{ mix accent bright_foreground 18% }};
activeButtonBgRipple: {{ mix accent bright_foreground 30% }};
activeButtonFg: {{ background }};
activeButtonFgOver: {{ background }};
activeButtonSecondaryFg: {{ mix background foreground 70% }};
activeButtonSecondaryFgOver: {{ background }};
activeLineFg: {{ accent }};
activeLineFgError: {{ bright_red }};

//== light / link buttons ====================================================
lightButtonBg: {{ mix background accent 12% }};
lightButtonBgOver: {{ mix background accent 20% }};
lightButtonBgRipple: {{ mix background accent 30% }};
lightButtonFg: {{ accent }};
lightButtonFgOver: {{ accent }};

//== attention (destructive) buttons =========================================
attentionButtonFg: {{ red }};
attentionButtonFgOver: {{ bright_red }};
attentionButtonBgOver: {{ mix background red 15% }};
attentionButtonBgRipple: {{ mix background red 25% }};

//== menus ===================================================================
menuBg: {{ dark_background }};
menuBgOver: {{ mix background foreground 10% }};
menuBgRipple: {{ mix background foreground 16% }};
menuIconFg: {{ dark_foreground }};
menuIconFgOver: {{ foreground }};
menuSubmenuArrowFg: {{ dark_foreground }};
menuFgDisabled: {{ mix background foreground 35% }};
menuSeparatorFg: {{ mix background foreground 14% }};

//== scrollbars ==============================================================
scrollBarBg: {{ mix background foreground 20% }};
scrollBarBgOver: {{ mix background foreground 32% }};
scrollBg: {{ mix background foreground 10% }};
scrollBgOver: {{ mix background foreground 16% }};

//== window title bar =======================================================
titleBg: {{ dark_background }};
titleBgActive: {{ dark_background }};
titleShadow: {{ darker_background }};
titleFg: {{ dark_foreground }};
titleFgActive: {{ foreground }};
titleButtonBg: {{ dark_background }};
titleButtonFg: {{ dark_foreground }};
titleButtonBgOver: {{ mix background foreground 12% }};
titleButtonFgOver: {{ foreground }};
titleButtonCloseBg: {{ dark_background }};
titleButtonCloseFg: {{ dark_foreground }};
titleButtonCloseBgOver: {{ red }};
titleButtonCloseFgOver: #ffffff;

//== inputs / checkboxes / sliders ==========================================
placeholderFg: {{ mix background foreground 40% }};
placeholderFgActive: {{ mix background foreground 55% }};
inputBorderFg: {{ mix background foreground 20% }};
filterInputBorderFg: {{ accent }};
checkboxFg: {{ mix background foreground 25% }};
sliderBgInactive: {{ mix background foreground 18% }};
sliderBgActive: {{ accent }};
radialFg: {{ accent }};
radialBg: {{ background }};

//== tooltips ===============================================================
tooltipBg: {{ dark_background }};
tooltipFg: {{ foreground }};
tooltipBorderFg: {{ mix background foreground 20% }};

//== left side bar (vertical folders / accounts strip) =====================
sideBarBg: {{ dark_background }};
sideBarBgActive: {{ accent }};
sideBarBgRipple: {{ mix background foreground 14% }};
sideBarTextFg: {{ dark_foreground }};
sideBarTextFgActive: {{ background }};
sideBarIconFg: {{ dark_foreground }};
sideBarIconFgActive: {{ background }};
sideBarBadgeBg: {{ accent }};
sideBarBadgeBgMuted: {{ mix background foreground 25% }};
sideBarBadgeBgActive: {{ background }};
sideBarBadgeBgMutedActive: {{ mix accent background 40% }};
sideBarBadgeFg: {{ background }};

//== misc active states ===================================================
windowBgActive: {{ accent }};
windowFgActive: {{ background }};
filterInputInactiveBg: {{ dark_background }};


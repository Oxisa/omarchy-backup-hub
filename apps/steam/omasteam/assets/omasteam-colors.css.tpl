/* omasteam — Steam colour variables generated by Omarchy from the active
 * theme's colors.toml. Rewritten on every `omarchy theme set`; Millennium
 * hot-reloads it. Do not edit by hand. The recolour rules that consume these
 * live in libraryroot.custom.css / friends.custom.css / bigpicture.custom.css. */

:root {
  --o-mode: {{ mode }};

  --o-bg:        {{ background }};
  --o-bg-dark:   {{ dark_background }};
  --o-bg-darker: {{ darker_background }};
  --o-elev1:     {{ mix background foreground 6% }};
  --o-elev2:     {{ mix background foreground 12% }};
  --o-elev3:     {{ mix background foreground 18% }};

  --o-fg:        {{ foreground }};
  --o-fg-bright: {{ bright_foreground }};
  --o-fg-dim:    {{ dark_foreground }};
  --o-fg-faint:  {{ mix background foreground 45% }};

  --o-accent:        {{ accent }};
  --o-accent-hover:  {{ mix accent bright_foreground 20% }};
  --o-accent-active: {{ mix accent bright_foreground 35% }};
  --o-accent-faint:  {{ mix background accent 14% }};
  --o-on-accent:     {{ background }};

  --o-border:        {{ mix background foreground 20% }};
  --o-border-strong: {{ mix background foreground 35% }};
  --o-hover:         {{ mix background foreground 8% }};
  --o-active:        {{ mix background foreground 16% }};

  --o-sel:    {{ selection_background }};
  --o-sel-fg: {{ selection_foreground }};

  --o-red:     {{ red }};
  --o-green:   {{ green }};
  --o-yellow:  {{ yellow }};
  --o-blue:    {{ blue }};
  --o-red-bright: {{ bright_red }};

  --o-bg-rgb:     {{ background_rgb }};
  --o-fg-rgb:     {{ foreground_rgb }};
  --o-accent-rgb: {{ accent_rgb }};
}
